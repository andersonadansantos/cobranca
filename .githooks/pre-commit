#!/bin/sh
# Incrementa a versao do sistema automaticamente antes de cada commit.
# A versao fica em config/version.txt (versionada) e e lida por config/version.php.

VERSION_FILE="config/version.txt"

if [ ! -f "$VERSION_FILE" ]; then
  echo "1.0" > "$VERSION_FILE"
fi

CURRENT=$(cat "$VERSION_FILE" | tr -d '\r\n ')
if ! echo "$CURRENT" | grep -Eq '^[0-9]+\.[0-9]+$'; then
  CURRENT="1.0"
fi

NEXT=$(awk "BEGIN { printf \"%.1f\", $CURRENT + 0.1 }")
echo "$NEXT" > "$VERSION_FILE"

git add "$VERSION_FILE"

echo "[versionamento] Versao atualizada: $CURRENT -> $NEXT"